# --- Binance API (Railway'de "Variables" bölümüne girin, bu dosyayı ASLA doldurup commit etmeyin) ---
# Anahtari olustururken SADECE "Enable Futures" isaretleyin.
# "Enable Withdrawals" ASLA isaretlenmeyecek - bot bunu acilista kontrol eder ve acizsa calismayi reddeder.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# true iken Binance Futures TESTNET kullanilir (https://testnet.binancefuture.com adresinden test anahtari alin)
TESTNET=true

# true iken emir GONDERILMEZ, sadece loglanir (ilk calistirmada boyle birakin)
DRY_RUN=true

# --- Strateji / risk ---
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,LTC/USDT
RISK_PER_TRADE=0.01
MAX_LEVERAGE=3
MONTHLY_KILL_SWITCH=0.08
FUNDING_LIMIT=0.001

# --- Telegram bildirimleri (opsiyonel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
